# ==============================================================================
# EMAIL SERVICE ENVIRONMENT VARIABLES
# ==============================================================================
EMAIL_PORT=8086
EMAIL_MONGODB_URI=mongodb://localhost:27017/sangrah_email

# SMTP Mail Server (Gmail or SMTP Relay)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEBUG=false
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000

# Sender Identity
APP_EMAIL_FROM=noreply@sangrah.com
APP_EMAIL_FROM_NAME=Sangrah Cloud Storage
APP_EMAIL_SUPPORT=support@sangrah.com

# Frontend Application URLs (for email action links)
APP_FRONTEND_URL=https://app.sangrah.com

# Eureka Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_REGISTER_WITH_EUREKA=true
EUREKA_FETCH_REGISTRY=true
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
EUREKA_INSTANCE_HOSTNAME=localhost

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_EMAIL=DEBUG
LOGGING_LEVEL_SPRING_MAIL=DEBUG
LOGGING_LEVEL_JAKARTA_MAIL=DEBUG

# Email Reconciliation Scheduler (Pending Zombie Recovery)
APP_EMAIL_RECONCILIATION_ENABLED=true
APP_EMAIL_RECONCILIATION_CRON=0 */5 * * * *
APP_EMAIL_RECONCILIATION_THRESHOLD_MINUTES=5
APP_EMAIL_RECONCILIATION_MAX_RETRIES=3


# MongoDB Configuration
SPRING_DATA_MONGODB_AUTO_INDEX_CREATION=true
