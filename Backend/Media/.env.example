# ============================================================
# Media Service — Environment Variable Template
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ============================================================

# Server
MEDIA_PORT=8087
MEDIA_HOSTNAME=localhost

# MongoDB
MEDIA_MONGODB_URI=mongodb://localhost:27017/sangrah_media

# Eureka
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION_MS=3600000

# Storage
SANGRAH_STORAGE_ROOT=./storage
SANGRAH_STORAGE_PROVIDER=LOCAL
STORAGE_LIMIT_BYTES=5368709120

# File Upload
MAX_FILE_SIZE=500MB
MAX_REQUEST_SIZE=500MB
MAX_IN_MEMORY_SIZE=10485760

# Async Storage Worker Thread Pool
MEDIA_ASYNC_CORE_POOL_SIZE=5
MEDIA_ASYNC_MAX_POOL_SIZE=20
MEDIA_ASYNC_QUEUE_CAPACITY=2000
MEDIA_ASYNC_THREAD_PREFIX=media-purge-

# Media Storage Garbage Collection Scheduler
MEDIA_GC_ENABLED=true
MEDIA_GC_CRON=0 0 2 * * ?
MEDIA_GC_RETENTION_DAYS=30
MEDIA_GC_BATCH_SIZE=100
