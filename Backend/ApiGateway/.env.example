# ==============================================================================
# Sangrah API Gateway - Environment Variable Template (.env.example)
# ==============================================================================
# Copy this file to .env in Backend/ApiGateway or configure these variables in
# your container orchestrator (Docker, Kubernetes) / runtime environment.
# All values assigned below correspond to the default fallbacks in application.properties.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Service Identity & Server Configuration
# ------------------------------------------------------------------------------
# Application name registered with Spring context
SPRING_APPLICATION_NAME=ApiGateway

# Gateway HTTP server listening port
GATEWAY_PORT=8080

# Spring main web application type (reactive for WebFlux/Spring Cloud Gateway)
SPRING_MAIN_WEB_APPLICATION_TYPE=reactive

# Context path for servlet/web requests (default: /)
SERVER_SERVLET_CONTEXT_PATH=/

# Enable HTTP response compression (gzip)
SERVER_COMPRESSION_ENABLED=true

# Error attribute include message mode: 'always', 'never', 'on_param'
SERVER_ERROR_INCLUDE_MESSAGE=always

# ------------------------------------------------------------------------------
# 2. Eureka Service Discovery Client Configuration
# ------------------------------------------------------------------------------
# Eureka Service Discovery server URL
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Whether to register ApiGateway with Eureka discovery registry
EUREKA_CLIENT_REGISTER_WITH_EUREKA=true

# Whether to fetch Eureka registry instances for client-side load balancing
EUREKA_CLIENT_FETCH_REGISTRY=true

# Prefer IP address over hostname when registering with Eureka
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true

# Health check actuator path registered with Eureka
EUREKA_INSTANCE_HEALTH_CHECK_PATH=/actuator/health

# Status/info actuator page path registered with Eureka
EUREKA_INSTANCE_STATUS_PAGE_PATH=/actuator/info

# Enable Spring Cloud Gateway Discovery Locator for dynamic service discovery
GATEWAY_DISCOVERY_LOCATOR_ENABLED=true

# Convert service IDs to lowercase when resolving via Discovery Locator
GATEWAY_DISCOVERY_LOCATOR_LOWERCASE=true

# ------------------------------------------------------------------------------
# 3. Microservice Route URIs & Predicates
# ------------------------------------------------------------------------------
# For Eureka load balancing, use 'lb://<SERVICE_NAME>'
# For direct HTTP routing (e.g. local standalone development), use 'http://localhost:<PORT>'

# Route 0: Auth Service (Default: lb://AUTH or http://localhost:8081)
AUTH_SERVICE_ROUTE_ID=auth-service
AUTH_SERVICE_URI=lb://AUTH
AUTH_SERVICE_PATH_PREDICATE=Path=/api/v1/auth/**,/api/v1/users/**

# Route 1: Gallery Service (Default: lb://GALLERY or http://localhost:8082)
GALLERY_SERVICE_ROUTE_ID=gallery-service
GALLERY_SERVICE_URI=lb://GALLERY
GALLERY_SERVICE_PATH_PREDICATE=Path=/api/v1/gallery/**

# Route 2: Event Service (Default: lb://EVENT or http://localhost:8083)
EVENT_SERVICE_ROUTE_ID=event-service
EVENT_SERVICE_URI=lb://EVENT
EVENT_SERVICE_PATH_PREDICATE=Path=/api/v1/events/**

# Route 3: Media Service (Default: lb://MediaService or http://localhost:8087)
MEDIA_SERVICE_ROUTE_ID=media-service
MEDIA_SERVICE_URI=lb://MediaService
MEDIA_SERVICE_PATH_PREDICATE=Path=/api/v1/media/**

# Route 4: Billing Service (Default: lb://BILLING or http://localhost:8084)
BILLING_SERVICE_ROUTE_ID=billing-service
BILLING_SERVICE_URI=lb://BILLING
BILLING_SERVICE_PATH_PREDICATE=Path=/api/v1/billing/**

# Route 5: Notification Service (Default: lb://NOTIFICATION or http://localhost:8085)
NOTIFICATION_SERVICE_ROUTE_ID=notification-service
NOTIFICATION_SERVICE_URI=lb://NOTIFICATION
NOTIFICATION_SERVICE_PATH_PREDICATE=Path=/api/v1/notifications/**

# ------------------------------------------------------------------------------
# 4. Reactive WebFlux Multipart File Upload Configuration
# ------------------------------------------------------------------------------
# Max in-memory buffer size for multipart uploads (default: 500MB to match Media/Gallery limits)
GATEWAY_MULTIPART_MAX_IN_MEMORY_SIZE=500MB

# Max multipart parts per request
GATEWAY_MULTIPART_MAX_PARTS=100

# ------------------------------------------------------------------------------
# 5. JWT Authentication & Token Validation Configuration
# ------------------------------------------------------------------------------
# Secret key used to sign and verify HMAC-SHA JWT tokens.
# CRITICAL: MUST be changed to a cryptographically secure 256+ bit secret in production!
JWT_SECRET=sangrah_secret_key_for_jwt_token_validation_please_change_in_production

# JWT token expiration window in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# JWT Claim key used to extract user role (default: role)
JWT_CLAIM_ROLE_KEY=role

# JWT Claim key used to extract user email (default: email)
JWT_CLAIM_EMAIL_KEY=email

# ------------------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing) Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. Frontend Angular/React clients)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://127.0.0.1:4200,http://127.0.0.1:3000

# Allowed HTTP request methods
CORS_ALLOWED_METHODS=GET,HEAD,POST,PUT,DELETE,OPTIONS,PATCH

# Allowed HTTP request headers
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization,X-CSRF-TOKEN

# HTTP headers exposed to client scripts
CORS_EXPOSED_HEADERS=Authorization,Content-Type

# Allow credentials (cookies, HTTP Authorization headers)
CORS_ALLOW_CREDENTIALS=true

# Preflight response cache max age in seconds (default: 3600 = 1 hour)
CORS_MAX_AGE=3600

# CORS path pattern mapping (default: /**)
CORS_PATH_PATTERN=/**

# ------------------------------------------------------------------------------
# 7. Gateway Security Rules: Open Endpoints & Role-Based Access Control (RBAC)
# ------------------------------------------------------------------------------
# Comma-separated URL prefixes that bypass JWT authentication
GATEWAY_OPEN_ENDPOINTS=/api/v1/auth/register,/api/v1/auth/login,/api/v1/auth/token/refresh,/api/v1/auth/token/validate,/swagger-ui/,/v3/api-docs/,/health,/actuator/

# Role requirements per endpoint path prefix (comma-separated allowed roles)
GATEWAY_ROLE_GALLERY=USER,ADMIN
GATEWAY_ROLE_MEDIA=USER,ADMIN
GATEWAY_ROLE_EVENTS=USER,ADMIN
GATEWAY_ROLE_BILLING=USER,ADMIN
GATEWAY_ROLE_NOTIFICATIONS=USER,ADMIN
GATEWAY_ROLE_ADMIN=ADMIN

# ------------------------------------------------------------------------------
# 8. Gateway Internal Headers & Authentication Filter Settings
# ------------------------------------------------------------------------------
# Trusted downstream header name for user ID (stripped from inbound client requests)
GATEWAY_HEADER_USER_ID=X-User-Id

# Trusted downstream header name for user email (stripped from inbound client requests)
GATEWAY_HEADER_USER_EMAIL=X-User-Email

# Authorization header Bearer prefix
GATEWAY_BEARER_PREFIX=Bearer 

# Query parameter name used to pass JWT token for media tags (e.g. <img>, <video>)
GATEWAY_TOKEN_QUERY_PARAM=token

# GlobalFilter execution order (negative value gives high priority before route filters)
GATEWAY_FILTER_ORDER=-1

# ------------------------------------------------------------------------------
# 9. Logging & Diagnostics Configuration
# ------------------------------------------------------------------------------
# Root logging level: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_ROOT=INFO

# ApiGateway application logging level
LOG_LEVEL_APIGATEWAY=DEBUG

# Spring Cloud Gateway routing framework logging level
LOG_LEVEL_SPRING_GATEWAY=DEBUG

# Netty/HttpWebHandlerAdapter adapter logging level
LOG_LEVEL_WEB_HANDLER=TRACE

# Console log output pattern
LOG_PATTERN_CONSOLE=%d{yyyy-MM-dd HH:mm:ss} - %logger{36} - %msg%n

# File log output pattern
LOG_PATTERN_FILE=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n

# JWT Claim Type and Expected Type
JWT_CLAIM_TYPE_KEY=type
GATEWAY_SECURITY_JWT_EXPECTED_TYPE=ACCESS
