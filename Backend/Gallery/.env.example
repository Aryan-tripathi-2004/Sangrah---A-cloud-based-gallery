# ============================================================
# Gallery Service — Environment Variable Template
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ============================================================

# Server
GALLERY_PORT=8082

# MongoDB
GALLERY_MONGODB_URI=mongodb://localhost:27017/sangrah_gallery

# JWT
JWT_SECRET=sangrah_secret_key_for_jwt_token_validation_please_change_in_production
JWT_EXPIRATION=86400000

# Eureka
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Media Service (Feign)
MEDIA_SERVICE_URL=http://localhost:8087

# Gallery Upload
GALLERY_MAX_FILE_SIZE=524288000

# File Upload
MAX_FILE_SIZE=500MB
MAX_REQUEST_SIZE=500MB
