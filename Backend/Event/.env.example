# ============================================================
# Event Service — Environment Variable Template
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ============================================================

# Server
EVENT_PORT=8083

# MongoDB
EVENT_MONGODB_URI=mongodb://localhost:27017/sangrah_event

# Storage
SANGRAH_STORAGE_ROOT=./storage

# Eureka
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false
EUREKA_INSTANCE_HOSTNAME=localhost

# Inter-service URLs
MEDIA_SERVICE_URL=http://localhost:8087
AUTH_SERVICE_URL=http://localhost:8081

# Reconciliation Scheduler
EVENT_MEDIA_RECONCILIATION_ENABLED=true
EVENT_MEDIA_RECONCILIATION_CRON=0 */5 * * * *
EVENT_MEDIA_RECONCILIATION_MAX_RETRIES=5
