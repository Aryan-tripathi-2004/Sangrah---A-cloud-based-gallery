# ==============================================================================
# AUTH SERVICE ENVIRONMENT VARIABLES
# ==============================================================================
AUTH_PORT=8081
AUTH_MONGODB_URI=mongodb://localhost:27017/sangrah_auth

# JWT Configuration
JWT_SECRET=sangrah_secret_key_for_jwt_token_validation_please_change_in_production
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800
JWT_DEFAULT_ROLE=USER

# Security & Gateway
SECURITY_HEADER_USER_ID=X-User-Id

# Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_REGISTER_WITH_EUREKA=true
EUREKA_FETCH_REGISTRY=true
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
EUREKA_INSTANCE_HEALTH_CHECK_PATH=/actuator/health
EUREKA_INSTANCE_STATUS_PAGE_PATH=/actuator/info

# Logging & Docs
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_AUTH=DEBUG
SPRINGDOC_API_DOCS_PATH=/api-docs
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui

# Session & Inter-service Configuration
AUTH_SESSION_MAX_ACTIVE=5
MEDIA_SERVICE_URL=http://localhost:8087
