# ==============================================================================
# Eureka Service Discovery Registry (.env.example)
# Service: eureka-registry-service
# Port: 8761
# Description: Central Service Discovery and Registry Server for Sangrah Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server Configuration
# ------------------------------------------------------------------------------
# The logical application name registered with Spring context
SPRING_APPLICATION_NAME=eureka-registry-service

# The port on which the Eureka Server listens
EUREKA_PORT=8761

# Base context path for the servlet container
SERVER_SERVLET_CONTEXT_PATH=/

# ------------------------------------------------------------------------------
# Eureka Discovery Server Configuration
# ------------------------------------------------------------------------------
# The hostname or IP address the Eureka server binds to
EUREKA_HOSTNAME=localhost

# Set to 'false' for single-node standalone dev server; set to 'true' for HA peer clusters
EUREKA_CLIENT_REGISTER_WITH_EUREKA=false

# Set to 'false' for single-node standalone dev server; set to 'true' for HA peer clusters
EUREKA_CLIENT_FETCH_REGISTRY=false

# URL of the Eureka server registry (defaultZone)
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# ------------------------------------------------------------------------------
# Actuator Management Endpoints
# ------------------------------------------------------------------------------
# Comma-separated list of actuator endpoints exposed over web HTTP
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Root logging level (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL_ROOT=INFO
