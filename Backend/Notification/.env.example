# ==============================================================================
# NOTIFICATION SERVICE ENVIRONMENT VARIABLES
# ==============================================================================
NOTIFICATION_PORT=8085
NOTIFICATION_MONGODB_URI=mongodb://localhost:27017/sangrah_notification

# Security & Header Configuration
NOTIFICATION_HEADER_USER_ID=X-User-Id

# Pagination Configuration
NOTIFICATION_PAGINATION_DEFAULT_SKIP=0
NOTIFICATION_PAGINATION_DEFAULT_LIMIT=50
NOTIFICATION_PAGINATION_MIN_SKIP=0
NOTIFICATION_PAGINATION_MIN_LIMIT=1
NOTIFICATION_PAGINATION_MAX_LIMIT=100

# Notification Preferences Default Configuration
NOTIFICATION_PREF_DEFAULT_IN_APP=true
NOTIFICATION_PREF_DEFAULT_EMAIL=false

# Error Handling Configuration (RFC-9457 ProblemDetail base URL)
ERROR_TYPE_BASE_URL=https://api.sangrah.com/errors

# Eureka Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_CLIENT_REGISTER_WITH_EUREKA=true
EUREKA_CLIENT_FETCH_REGISTRY=true
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
EUREKA_INSTANCE_HEALTH_CHECK_PATH=/actuator/health
EUREKA_INSTANCE_STATUS_PAGE_PATH=/actuator/info

# Logging & Docs
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_NOTIFICATION=DEBUG
SPRINGDOC_API_DOCS_PATH=/api-docs
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui
