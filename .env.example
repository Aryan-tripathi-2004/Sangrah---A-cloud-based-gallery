# ============================================================
# Sangrah Platform — Root Environment Variable Template
# ============================================================
# Copy this file to .env and populate all values before running.
# Each service has its own .env.example in its directory for
# service-specific overrides.
#
# DO NOT commit .env or any file with real secrets to version control.
# ============================================================

# ------------------------------------------------------------
# SHARED INFRASTRUCTURE
# ------------------------------------------------------------
# Eureka Registry — all services register here
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# JWT Secret — must be identical across all services that validate tokens
JWT_SECRET=your-secret-key-change-in-production

# MongoDB — each service uses its own database
AUTH_MONGODB_URI=mongodb://localhost:27017/sangrah_auth
BILLING_MONGODB_URI=mongodb://localhost:27017/sangrah_billing
EMAIL_MONGODB_URI=mongodb://localhost:27017/sangrah_email
EVENT_MONGODB_URI=mongodb://localhost:27017/sangrah_event
GALLERY_MONGODB_URI=mongodb://localhost:27017/sangrah_gallery
MEDIA_MONGODB_URI=mongodb://localhost:27017/sangrah_media
NOTIFICATION_MONGODB_URI=mongodb://localhost:27017/sangrah_notification

# ------------------------------------------------------------
# SERVICE PORTS
# ------------------------------------------------------------
EUREKA_PORT=8761
API_GATEWAY_PORT=8080
AUTH_PORT=8081
GALLERY_PORT=8082
EVENT_PORT=8083
BILLING_PORT=8084
NOTIFICATION_PORT=8085
EMAIL_PORT=8086
MEDIA_PORT=8087

# ------------------------------------------------------------
# INTER-SERVICE URLs (used by Feign/RestTemplate clients)
# ------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8081
GALLERY_SERVICE_URL=http://localhost:8082
EVENT_SERVICE_URL=http://localhost:8083
BILLING_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
EMAIL_SERVICE_URL=http://localhost:8086
MEDIA_SERVICE_URL=http://localhost:8087

# ------------------------------------------------------------
# API GATEWAY
# ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,X-User-Id

# ------------------------------------------------------------
# AUTH SERVICE
# ------------------------------------------------------------
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800
DEFAULT_USER_ROLE=ROLE_USER
ACCESS_TOKEN_MAX_AGE_SECONDS=3600

# ------------------------------------------------------------
# EMAIL SERVICE
# ------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
EMAIL_SUPPORT_ADDRESS=support@sangrah.com
FRONTEND_BASE_URL=https://app.sangrah.com

# ------------------------------------------------------------
# NOTIFICATION SERVICE
# ------------------------------------------------------------
NOTIFICATION_PAGE_SIZE=20
NOTIFICATION_MAX_PAGE_SIZE=100

# ------------------------------------------------------------
# GALLERY SERVICE
# ------------------------------------------------------------
GALLERY_MAX_FILE_SIZE=524288000
MAX_FILE_SIZE=500MB
MAX_REQUEST_SIZE=500MB
JWT_EXPIRATION=86400000

# ------------------------------------------------------------
# MEDIA SERVICE
# ------------------------------------------------------------
SANGRAH_STORAGE_ROOT=./storage
SANGRAH_STORAGE_PROVIDER=LOCAL
STORAGE_LIMIT_BYTES=5368709120
MAX_IN_MEMORY_SIZE=10485760
MEDIA_HOSTNAME=localhost
JWT_EXPIRATION_MS=3600000

# ------------------------------------------------------------
# BILLING SERVICE
# ------------------------------------------------------------
# Stripe Keys (REQUIRED for payment processing)
# Get from: https://dashboard.stripe.com/developers/apikeys
STRIPE_API_KEY=sk_test_REPLACE_WITH_REAL_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_REAL_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_REAL_SECRET

# Webhook
WEBHOOK_TIMEOUT_MS=300000
WEBHOOK_EVENT_MAX_AGE=600

# Billing Business
BILLING_CURRENCY=usd
BILLING_DEFAULT_COUNTRY=IN
BILLING_DEFAULT_POSTAL_CODE=000000
BILLING_STORAGE_LIMIT_BYTES=5368709120
BILLING_INVOICE_DUE_DAYS=15
BILLING_DEFAULT_COST_ALERT_THRESHOLD=100.0
BILLING_FALLBACK_EMAIL=billing@sangrah.com
BILLING_PAYMENT_RETRY_MAX_ATTEMPTS=3
BILLING_PAYMENT_RETRY_INTERVAL_HOURS=24
BILLING_PAYMENT_RETRY_CHECK_INTERVAL_MS=3600000

# Scheduling
ENABLE_BATCH_JOBS=true
SCHEDULING_ENABLED=true
