# ============================================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================================
# INSTRUCTIONS: Copy this file to .env and fill in your values
#
#   cp .env.example .env
#
# Then replace the placeholder values with your actual keys

# Stripe Public Key for development (starts with pk_test_)
# Get from: https://dashboard.stripe.com/test/apikeys
NG_APP_STRIPE_PUBLIC_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Backend API URL
# For local development: http://localhost:8080
# For production: https://api.sangrah.com (your API URL)
NG_APP_API_URL=http://localhost:8080

# Application environment
# Use: development, staging, or production
NG_APP_ENVIRONMENT=development

# ============================================================
# IMPORTANT SECURITY NOTES
# ============================================================
# 1. NEVER commit .env file to git (it's in .gitignore)
# 2. Only .env.example should be committed (no secrets here)
# 3. Each developer/environment needs their own .env file
# 4. Stripe Public Key is safe to share (it's public)
# 5. For production, use live keys (pk_live_...) NOT test keys
